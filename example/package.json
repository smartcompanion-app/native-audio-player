{
  "name": "capacitor-example-app",
  "description": "Usage Example Native Audio Player",
  "private": true,
  "main": "index.js",
  "type": "module",
  "keywords": [
    "capacitor",
    "mobile"
  ],
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "build:android": "cd android && ./gradlew build && cd ..",
    "build:ios": "xcodebuild -project ./ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -derivedDataPath ./ios/build",
    "test:android": "npx wdio run ./wdio.conf.js",
    "test:ios": "APPIUM_PLATFORM=ios npx wdio run ./wdio.conf.js",
    "test:browser": "APPIUM_PLATFORM=browser npx wdio run ./wdio.conf.js",
    "screenshots": "npx wdio run ./screenshots.conf.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "9.0.0-beta.0",
    "@capacitor/core": "9.0.0-beta.0",
    "@capacitor/filesystem": "8.2.0-next.7",
    "@capacitor/ios": "9.0.0-beta.0",
    "@capacitor/splash-screen": "9.0.0-alpha.2",
    "@smartcompanion/native-audio-player": "file:.."
  },
  "devDependencies": {
    "@capacitor/cli": "9.0.0-beta.0",
    "@wdio/appium-service": "^10.0.2",
    "@wdio/cli": "^10.0.2",
    "@wdio/globals": "^10.0.2",
    "@wdio/local-runner": "^10.0.2",
    "@wdio/mocha-framework": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "appium-xcuitest-driver": "^12.22.0",
    "vite": "^8.3.4",
    "webdriverio": "^10.0.2"
  },
  "author": "SmartCompanion <hello@smartcompanion.app>",
  "license": "BSD-2-Clause"
}
