{
  "name": "capacitor-example-app",
  "description": "Usage Example Native Audio Player",
  "main": "index.js",
  "type": "module",
  "keywords": [
    "capacitor",
    "mobile"
  ],
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "build:android": "cd android && ./gradlew build && cd ..",
    "build:ios": "xcodebuild -project ./ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -derivedDataPath ./ios/build",
    "test:android": "npx wdio run ./wdio.conf.js",
    "test:ios": "APPIUM_PLATFORM=ios npx wdio run ./wdio.conf.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@smartcompanion/native-audio-player": "file:.."
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@wdio/appium-service": "^9.30.0",
    "@wdio/cli": "^9.30.0",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "appium": "^3.6.0",
    "appium-uiautomator2-driver": "^8.2.0",
    "appium-xcuitest-driver": "^12.1.0",
    "vite": "^8.1.5",
    "webdriverio": "^9.30.0"
  },
  "author": "SmartCompanion <hello@smartcompanion.app>",
  "license": "BSD-2-Clause"
}
