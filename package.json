{
  "name": "@smartcompanion/native-audio-player",
  "version": "0.5.0",
  "description": "Play Native Audio from a Capacitor App",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources",
    "ios/Tests",
    "ios/Plugin/",
    "Package.swift",
    "SmartcompanionNativeAudioPlayer.podspec"
  ],
  "author": "SmartCompanion <hello@smartcompanion.app>",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartcompanion-app/native-audio-player.git"
  },
  "bugs": {
    "url": "https://github.com/smartcompanion-app/native-audio-player/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "audio-player"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:ios": "xcodebuild -scheme SmartcompanionNativeAudioPlayer -destination generic/platform=iOS && npm run test:ios",
    "test:ios": "sh scripts/test-ios.sh",
    "verify:android": "cd android && ./gradlew build test && cd ..",
    "verify:web": "npm run build",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- --fix --format",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --api NativeAudioPlayerPlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^8.4.2",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@ionic/eslint-config": "^0.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "@types/node": "^26.1.1",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-java": "^2.10.3",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.2",
    "swiftlint": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "lint-staged": {
    "**/*.{css,html,ts,js,java}": "prettier --write --plugin=prettier-plugin-java"
  }
}
