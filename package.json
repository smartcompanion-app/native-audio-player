{
  "name": "@smartcompanion/native-audio-player",
  "version": "1.0.2",
  "description": "Capacitor plugin for native audio playback: background playback, lock screen and notification controls, playlists, and earpiece/speaker routing on iOS, Android and the web.",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources",
    "ios/Tests",
    "Package.swift",
    "SmartcompanionNativeAudioPlayer.podspec"
  ],
  "author": "SmartCompanion <hello@smartcompanion.app>",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartcompanion-app/native-audio-player.git"
  },
  "bugs": {
    "url": "https://github.com/smartcompanion-app/native-audio-player/issues"
  },
  "homepage": "https://github.com/smartcompanion-app/native-audio-player#readme",
  "keywords": [
    "capacitor",
    "capacitor-plugin",
    "ionic",
    "plugin",
    "native",
    "audio",
    "audio-player",
    "background-audio",
    "media-session",
    "lock-screen",
    "playlist",
    "earpiece",
    "speaker",
    "exoplayer",
    "media3",
    "avaudioplayer",
    "ios",
    "android"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:ios": "xcodebuild -scheme SmartcompanionNativeAudioPlayer -destination generic/platform=iOS && npm run test:ios",
    "test:ios": "sh scripts/test-ios.sh",
    "verify:android": "cd android && ./gradlew build test && cd ..",
    "verify:web": "npm run build && npm run test:web",
    "test:web": "vitest run",
    "test:web:watch": "vitest",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- --fix --format",
    "eslint": "eslint",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --api NativeAudioPlayerPlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^8.5.3",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@ionic/eslint-config": "^0.5.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "@types/node": "^26.6.5",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "prettier-plugin-java": "^2.11.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.5",
    "swiftlint": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "lint-staged": {
    "**/*.{css,html,ts,js,java}": "prettier --write --plugin=prettier-plugin-java"
  }
}
